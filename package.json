    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@videojs/mux-video": "10.3.0",
    "@videojs/react": "10.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
