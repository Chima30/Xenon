{
  "name": "untitled-cinema-interface",
  "private": true,
  "version": "0.1.0",
  "description": "Untitled cinema interface: a Video.js v10 custom skin with a Movies/Scenes navigation wheel and a personal moment atlas.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
